//@version=5
indicator("ObsidianMultiAssetTrend", overlay=false, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// =============================================================================
// Obsidian-RL Cross-Market Trend Engine V1 — Pine Script Indicator
// =============================================================================
// This indicator mirrors the authoritative Python TrendEngine V1 implementation
// exactly. It is for VISUALIZATION and ALERT GENERATION ONLY.
// It does NOT execute trades, manage positions, or calculate portfolio sizing.
// Python remains the sole authority for all quantitative decisions.
// =============================================================================

// --- Configuration (must match Python TrendConfig exactly) ---
short_horizon_days   = input.int(20,  minval=1, title="Short Horizon (days)")
medium_horizon_days  = input.int(60,  minval=1, title="Medium Horizon (days)")
long_horizon_days    = input.int(120, minval=1, title="Long Horizon (days)")

// Timeframe validation (Python only supports 4h and 1d)
tf_valid = (timeframe.period == "240" or timeframe.period == "D")
not_supported = not tf_valid
// Note: Pine cannot raise errors at bar 0 for unsupported timeframes cleanly.
// We guard calculations below and emit NaN for unsupported timeframes.

// --- Helper: Determine bars per day for timeframe ---
bars_per_day = timeframe.period == "240" ? 6 : 1

// --- Required history calculation ---
short_bars = short_horizon_days * bars_per_day
med_bars   = medium_horizon_days * bars_per_day
long_bars  = long_horizon_days * bars_per_day
max_bars_needed = long_bars + 1  // +1 for return calculation

// --- Input data quality validation ---
// All validation uses only CONFIRMED bars (barstate.isconfirmed)
// No future data, no repaint

// Validate we have enough history
enough_history = bar_index >= (max_bars_needed - 1)

// Validate close price is finite and positive
close_valid = not na(close) and close > 0

// --- Core Calculations (only computed when all conditions met) ---
// Returns over horizons
// ret = (latest_close - past_close) / past_close
// We use close[short_bars] etc. which is the close `short_bars` bars ago
ret_short = enough_history and close_valid and not na(close[short_bars]) and close[short_bars] > 0
    ? (close - close[short_bars]) / close[short_bars]
    : na

ret_med = enough_history and close_valid and not na(close[med_bars]) and close[med_bars] > 0
    ? (close - close[med_bars]) / close[med_bars]
    : na

ret_long = enough_history and close_valid and not na(close[long_bars]) and close[long_bars] > 0
    ? (close - close[long_bars]) / close[long_bars]
    : na

// 20d Volatility (std dev of log returns over short_bars)
// Python: log_returns = log(p[i]/p[i-1]) for i=1..short_bars
// Then std(log_returns)
log_returns_short = array.new_float(0)
if enough_history and close_valid
    for i = 1 to short_bars
        p_curr = close[i - 1]
        p_prev = close[i]
        if p_curr > 0 and p_prev > 0
            array.push(log_returns_short, math.log(p_curr / p_prev))

vol_20d = array.size(log_returns_short) == short_bars
    ? math.sqrt(array.avg(array.map(log_returns_short, "x -> (x - array.avg(log_returns_short)) ^ 2")))
    : na

// --- Signal Logic (exact mirror of Python) ---
direction = "FLAT"
score     = 0.0
reason    = ""

if not tf_valid
    direction := "UNSUPPORTED_TF"
    score := na
    reason := "Timeframe must be 4h or 1d"
else if not enough_history
    direction := "WARMING_UP"
    score := na
    reason := str.tostring("Need " + str.tostring(max_bars_needed) + " bars, have " + str.tostring(bar_index + 1))
else if not close_valid
    direction := "INVALID_DATA"
    score := na
    reason := "Invalid close price"
else if ret_short > 0 and ret_med > 0 and ret_long > 0
    direction := "LONG"
    score := 1.0
    reason := "All three horizon returns are strictly positive."
else if ret_short < 0 and ret_med < 0 and ret_long < 0
    direction := "SHORT"
    score := -1.0
    reason := "All three horizon returns are strictly negative."
else
    direction := "FLAT"
    // Average of signs across three horizons
    s_short = ret_short > 0 ? 1 : (ret_short < 0 ? -1 : 0)
    s_med   = ret_med   > 0 ? 1 : (ret_med   < 0 ? -1 : 0)
    s_long  = ret_long  > 0 ? 1 : (ret_long  < 0 ? -1 : 0)
    score := (s_short + s_med + s_long) / 3.0
    reason := "Mixed or zero returns across horizons."

// --- Output for Visualization ---
plot(score,     title="Trend Score", color=color.new(color.blue, 0), linewidth=2)
plot(vol_20d,   title="Vol 20d",     color=color.new(color.orange, 0), linewidth=1)
hline(0, "Zero Line", color=color.new(color.gray, 50))

// Direction as colored background
bgcolor(direction == "LONG"  ? color.new(color.green, 90) :
        direction == "SHORT" ? color.new(color.red, 90) :
        direction == "FLAT"  ? color.new(color.gray, 90) :
        na, title="Direction Background")

// --- Alert Generation (CONFIRMED BARS ONLY) ---
// Alerts fire on confirmed bar close only (no intrabar/repaint)
alert_condition_long  = direction == "LONG"  and barstate.isconfirmed
alert_condition_short = direction == "SHORT" and barstate.isconfirmed
alert_condition_flat  = direction == "FLAT"  and barstate.isconfirmed

// Deterministic event_id: hash of symbol+timeframe+bar_timestamp+direction
// This allows duplicate detection in the webhook receiver
event_id = str.tostring(syminfo.ticker) + "_" + timeframe.period + "_" + str.tostring(time) + "_" + direction

// Alert payload fields (informational only, no secrets)
alert_message_long  = '{"schema_version": "1", "event_id": "' + event_id + '", "symbol": "' + syminfo.ticker + '", "timeframe": "' + timeframe.period + '", "bar_timestamp_utc": ' + str.tostring(time) + ', "signal": "LONG", "score": ' + str.tostring(score, "#.####") + ', "vol_20d": ' + str.tostring(vol_20d, "#.########") + ', "latest_close": ' + str.tostring(close, "#.########") + ', "engine_version": "TrendEngineV1", "config_identity": "TODO_PYTHON_HASH"}'
alert_message_short = '{"schema_version": "1", "event_id": "' + event_id + '", "symbol": "' + syminfo.ticker + '", "timeframe": "' + timeframe.period + '", "bar_timestamp_utc": ' + str.tostring(time) + ', "signal": "SHORT", "score": ' + str.tostring(score, "#.####") + ', "vol_20d": ' + str.tostring(vol_20d, "#.########") + ', "latest_close": ' + str.tostring(close, "#.########") + ', "engine_version": "TrendEngineV1", "config_identity": "TODO_PYTHON_HASH"}'
alert_message_flat  = '{"schema_version": "1", "event_id": "' + event_id + '", "symbol": "' + syminfo.ticker + '", "timeframe": "' + timeframe.period + '", "bar_timestamp_utc": ' + str.tostring(time) + ', "signal": "FLAT", "score": ' + str.tostring(score, "#.####") + ', "vol_20d": ' + str.tostring(vol_20d, "#.########") + ', "latest_close": ' + str.tostring(close, "#.########") + ', "engine_version": "TrendEngineV1", "config_identity": "TODO_PYTHON_HASH"}'

alert(alert_condition_long,  message=alert_message_long,  freq=alert.freq_once_per_bar_close)
alert(alert_condition_short, message=alert_message_short, freq=alert.freq_once_per_bar_close)
alert(alert_condition_flat,  message=alert_message_flat,  freq=alert.freq_once_per_bar_close)

// --- Plot labels for visual debugging ---
var label dir_label = na
if barstate.islast
    label.delete(dir_label)
    dir_label := label.new(bar_index, 0, "Dir: " + direction + "\nScore: " + str.tostring(score, "#.####") + "\nVol: " + str.tostring(vol_20d, "#.########"), color=direction == "LONG" ? color.green : direction == "SHORT" ? color.red : color.gray, textcolor=color.white, style=label.style_label_down, size=size.normal)

// --- Static Assertions (Pine cannot enforce at compile time, documented for Red Team) ---
// ASSERT: This is an indicator(), NOT a strategy()
// ASSERT: No strategy.entry / strategy.order / strategy.exit / strategy.close calls
// ASSERT: Uses only confirmed bars (barstate.isconfirmed) for alerts
// ASSERT: No lookahead_on or request.security with lookahead
// ASSERT: No secret/token/password strings in this file
// ASSERT: Deterministic calculations (no random, no external calls)
// ASSERT: event_id is deterministic for duplicate detection