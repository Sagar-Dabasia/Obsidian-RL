+
+    rollback(models_dir)
+
+    assert json.loads(
+        (models_dir / candidate_id / METADATA_FILE).read_text(encoding="utf-8")
+    ) == meta_a
+    assert json.loads(
+        (models_dir / other_id / METADATA_FILE).read_text(encoding="utf-8")
+    ) == meta_b
